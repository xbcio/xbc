# A Docker build uses the repository as its context, because the workspace's
# go.work is what resolves the XBC modules an example imports. Everything here
# is either history, a local working directory, or a runtime artifact that must
# not be copied into an image.
.git
.github
.idea
.vscode
.omc
.worktrees
.superpowers
.claude

# Runtime artifacts. A SQLite database among them could carry data from a
# developer's machine into an image.
**/*.db
**/*.db-wal
**/*.db-shm
**/logs
