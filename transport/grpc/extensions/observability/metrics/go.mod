module github.com/xbcio/xbc/transport/grpc/extensions/observability/metrics

go 1.25.0

// Core, transport/grpc, and the neutral metrics plugin
// github.com/xbcio/xbc/extensions/observability/metrics are deliberately
// resolved by the repository workspace until they have real published
// versions. Do not add a local replace or an unpublished placeholder
// requirement here. It is a module of its own so the Prometheus client never
// enters transport/grpc's closure.
require (
	github.com/prometheus/client_golang v1.23.2
	google.golang.org/grpc v1.81.1
)

require (
	github.com/beorn7/perks v1.0.1 // indirect
