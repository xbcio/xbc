module github.com/xbcio/xbc/transport/grpc

go 1.25.0

// Core is deliberately resolved by the repository workspace until it has a
// real published version. Do not add a local replace or an unpublished
// placeholder requirement here. This module never imports transport/web: the
// two transports are modelled separately and share only protocol-neutral
// contracts.
require google.golang.org/grpc v1.81.1

require (
	github.com/gabriel-vasile/mimetype v1.4.13 // indirect
	github.com/go-playground/locales v0.14.1 // indirect
