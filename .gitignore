# macOS
.DS_Store

# Editors
.idea/
.vscode/

# Go
*.exe
*.test
*.out
vendor/

# go.work must remain tracked: plugins/*/* and examples are independent modules,
# and local replace directives are intentionally forbidden. Before core's first
# release tag, they can resolve core only through go.work. Ignoring it would break
# plugin module builds in fresh clones and CI.

# Local configuration (may contain credentials; never commit)
/application.yml
/configs/application.yml
application-local.yml
*.local.yml
.env

# Runtime artifacts
**/logs/

# Tool working directories
.superpowers/
.worktrees/

# Local design documents and implementation plans
/.claude/specs/
/.claude/plans/
