#!/bin/sh
# Verify every workspace module resolves and verifies its own manifest with
# the workspace disabled (GOWORK=off), as a published consumer would see it.
set -eu

go_cmd=${GO:-go}
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
workspace=$repository_root/go.work
if [ ! -f "$workspace" ]; then
	echo "workspace not found: $workspace" >&2
	exit 1
fi

modules_file=$(mktemp "${TMPDIR:-/tmp}/xbc-modules.XXXXXX")
trap 'rm -f "$modules_file"' EXIT HUP INT TERM

GOWORK="$workspace" "$go_cmd" work edit -json "$workspace" |
	awk -F'"' '/"DiskPath"[[:space:]]*:/ { print $4 }' >"$modules_file"

count=0
failed=0
while IFS= read -r module_dir; do
	[ -n "$module_dir" ] || continue
	case "$module_dir" in
		/*) ;;
		*) module_dir=$(CDPATH= cd -- "$(dirname -- "$workspace")/$module_dir" && pwd) ;;
	esac
	count=$((count + 1))
	printf '\n==> %s: GOWORK=off go list -mod=readonly -m all\n' "$module_dir"
	if ! (cd "$module_dir" && GOWORK=off "$go_cmd" list -mod=readonly -m all >/dev/null); then
		echo "FAIL: $module_dir: go list -mod=readonly -m all" >&2
		failed=1
	fi
	printf '\n==> %s: GOWORK=off go mod verify\n' "$module_dir"
	if ! (cd "$module_dir" && GOWORK=off "$go_cmd" mod verify); then
		echo "FAIL: $module_dir: go mod verify" >&2
		failed=1
	fi
done <"$modules_file"

if [ "$count" -eq 0 ]; then
	echo "no workspace modules discovered" >&2
	exit 1
fi

if [ "$failed" -ne 0 ]; then
	exit 1
fi
