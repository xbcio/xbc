go 1.25.0

// go.work is committed on purpose. This repository contains independently
// publishable core, transport, grouped protocol-neutral extensions,
// transport-owned extensions, and example modules. Lightweight Web extensions
// remain packages inside the transport/web module, while dependency-heavy
// extension leaves are independently publishable modules. Every Web plugin
// lives beneath a capability group under transport/web/extensions. Engine
// adapters are not Web plugins -- each implements the neutral web.Engine port
// rather than a Web capability -- so they live beneath their own
// transport/web/engines namespace, one publishable module per adapter.
// Local development resolves XBC imports through this workspace; publishable
// child manifests must not use filesystem replaces, v0.0.0 requirements, or
// synthetic pseudo-versions, and their XBC requirements name released tags.
// The workspace is a convenience, never a consumer dependency.
use (
	.
	./examples
	./extensions/authentication
	./extensions/authentication/apikey
	./extensions/authentication/jwt
	./extensions/authentication/oidc
	./extensions/authentication/session
	./extensions/authorization/casbin
	./extensions/authorization/casbin-gorm
	./extensions/authorization/casbin-redis
	./extensions/authorization/rbac
	./extensions/concurrency/async
	./extensions/coordination/lease
	./extensions/coordination/placement
	./extensions/coordination/raft
	./extensions/httpclient
	./extensions/jobs/asynq
	./extensions/jobs/cron
	./extensions/messaging/kafka
	./extensions/messaging/outbox
	./extensions/messaging/webhook
	./extensions/observability/metrics
	./extensions/observability/tracing
	./extensions/reliability/gracefulshutdown
	./extensions/reliability/health
	./extensions/storage/elasticsearch
	./extensions/storage/gorm
	./extensions/storage/objectstorage
	./extensions/storage/redis
	./extensions/tasks
	./scripts/plugin-snapshots
	./tests/composition
	./transport/grpc
	./transport/grpc/extensions/authentication/jwt
	./transport/grpc/extensions/authorization/casbin
	./transport/grpc/extensions/observability/metrics
	./transport/grpc/extensions/observability/tracing
	./transport/web
	./transport/web/engines/gin
	./transport/web/extensions/authentication/jwt
	./transport/web/extensions/authentication/session
	./transport/web/extensions/authorization/casbin
	./transport/web/extensions/authorization/rbac
	./transport/web/extensions/observability/metrics
	./transport/web/extensions/observability/tracing
	./transport/web/extensions/openapi/swag
	./transport/web/extensions/reliability/idempotency
)
